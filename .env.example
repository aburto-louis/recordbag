# server / proxy
PORT=3000
SERVER_ORIGIN=http://localhost:3000
CLIENT_PORT=5173

# db - leave out to use default path
# DB_PATH=/absolute/path/to/db.sqlite

# cloudflare r2
S3_ENDPOINT="https://<secret-token>.r2.cloudflarestorage.com"
S3_BUCKET="bucket_name"
S3_ACCESS_KEY_ID="<secret-token>"
S3_SECRET_ACCESS_KEY="<secret-token>"

# admin user seed
SEED_ADMIN_NAME="Full Name"
SEED_ADMIN_EMAIL="email@email.me"
SEED_ADMIN_USERNAME="username"
SEED_ADMIN_PASSWORD="Password1"
SEED_ADMIN_COUNTRY="MX"
SEED_ADMIN_AVI="users/avi/<UUID_V4>.[jpeg | jpg | png | webp]"
